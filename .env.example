# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side admin passcode (leave unset to use first-run admin setup in UI).
ADMIN_PASSCODE=

# SESSION_SECRET: Secret for signing bearer session tokens (auto-generated in memory if unset).
SESSION_SECRET=
