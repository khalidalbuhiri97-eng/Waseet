# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side admin passcode (leave unset to use first-run admin setup in UI).
ADMIN_PASSCODE=

# SESSION_SECRET: Required in production; generate a random secret of at least 32 characters.
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
